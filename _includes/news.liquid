<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign news_visible = 5 %}
    <ul class="recent-news">
      {% for item in news limit: news_visible %}
        <li>
          <span class="news-date">[{{ item.date | date: '%b %Y' }}]</span>
          {% if item.inline %}
            <span class="news-text">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</span>
          {% else %}
            <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    {% if news_limit > news_visible %}
      {% assign news_hidden = news_limit | minus: news_visible %}
      <details class="news-more">
        <summary>Show older news ({{ news_hidden }})</summary>
        <ul class="recent-news">
          {% for item in news offset: news_visible limit: news_hidden %}
            <li>
              <span class="news-date">[{{ item.date | date: '%b %Y' }}]</span>
              {% if item.inline %}
                <span class="news-text">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</span>
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
